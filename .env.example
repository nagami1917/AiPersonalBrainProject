# ---------------------------------------------------------------------------
# NEXUS environment template — copy to .env and fill in.
#
# RULE: a secret lives in exactly one place per environment. The backend fails
# to start when a required value is missing, rather than degrading silently.
# ---------------------------------------------------------------------------

# --- Backend (apps/api) -----------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=            # local CLI default: super-secret-jwt-token-with-at-least-32-characters-long

# Direct Postgres connection used for SQL (asyncpg)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PINNED_EMBEDDING_MODEL=text-embedding-3-small
PINNED_EMBEDDING_DIM=1536

# Retrieval tuning (defaults live in code; override only with an eval result)
RETRIEVAL_K=8
CANDIDATE_K=40
SCORE_FLOOR=0.008
MMR_LAMBDA=0.7
VECTOR_WEIGHT=1.0
KEYWORD_WEIGHT=0.7
RRF_K=60

# Limits
MAX_UPLOAD_BYTES=52428800
CORS_ALLOWED_ORIGINS=http://localhost:5173
WORKER_CONCURRENCY=2

# Trash retention. A deleted note or document stays restorable for this many
# days before the worker purges it and (for documents) removes the stored file.
# 0 disables recovery: delete becomes immediate and permanent.
TRASH_RETENTION_DAYS=30

# Optional
SENTRY_DSN=

# --- Frontend (apps/web) ----------------------------------------------------
# Only PUBLIC_* values reach the browser. Never put a service role key here.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
