# =============================================================================
# NEXUS — backend environment template (apps/api)
#
# Copy to apps/api/.env and fill in. NEVER commit the filled-in file: `.env`
# and `.env.*` are gitignored (only this `.example` is tracked).
#
# The backend refuses to start when a required value is missing. That is
# deliberate: a process that boots without an embedding key builds an
# unsearchable index silently, which is worse than a crash.
#
# Values marked REQUIRED have no default. Everything else is a knob whose
# default is in app/core/config.py and should only be changed with a reason.
# =============================================================================

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=local                 # local | test | preview | production
LOG_LEVEL=INFO

# --- Supabase ----------------------------------------------------------------
# Local development uses legacy keys. For hosted production, set the new keys
# and ES256 after rotating the Supabase signing key; see docs/SUPABASE-KEY-MIGRATION.md.
SUPABASE_URL=http://127.0.0.1:54321                          # REQUIRED
SUPABASE_ANON_KEY=                                           # REQUIRED
SUPABASE_SERVICE_ROLE_KEY=                                   # REQUIRED — server only, bypasses RLS
SUPABASE_JWT_SECRET=                                         # required for HS256 only
# SUPABASE_PUBLISHABLE_KEY=                                  # preferred over ANON_KEY
# SUPABASE_SECRET_KEY=                                       # preferred over SERVICE_ROLE_KEY
# SUPABASE_JWT_ALGORITHM=ES256                               # hosted asymmetric signing

# --- database ----------------------------------------------------------------
# The spec names it SUPABASE_DB_URL; this codebase has always used DATABASE_URL.
# Both work — DATABASE_URL is read first, SUPABASE_DB_URL is the fallback — so a
# value pasted from either document works without renaming anything.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_DB_URL=

# --- AI provider -------------------------------------------------------------
# The spec names these AI_API_KEY / AI_MODEL / EMBEDDING_MODEL. The aliases are
# accepted for the same reason as the DB URL: two plausible spellings of the same
# setting should not become a boot failure.
OPENAI_API_KEY=                       # REQUIRED — never leaves the server
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PINNED_EMBEDDING_MODEL=text-embedding-3-small
PINNED_EMBEDDING_DIM=1536             # must match the model, or retrieval silently returns nothing

# --- CORS --------------------------------------------------------------------
# Exact origins, comma-separated. Never `*` with credentials.
# The spec names it ALLOWED_ORIGINS; both spellings are read.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173

# --- limits ------------------------------------------------------------------
# The spec names it MAX_UPLOAD_SIZE_MB. Both spellings are read; the byte value
# wins when set. 25 MB is the spec's example — raise it only with a bucket
# `file_size_limit` change to match, since Storage enforces its own ceiling.
MAX_UPLOAD_SIZE_MB=25
# MAX_UPLOAD_BYTES=52428800

# Rate limits for provider-calling endpoints. Per user AND per workspace.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_USER_CALLS=30
RATE_LIMIT_WORKSPACE_CALLS=240

# --- retrieval tuning --------------------------------------------------------
# Defaults are tuned against the eval set. Changing one without a measurement is
# how retrieval quality regresses invisibly.
RETRIEVAL_K=8
CANDIDATE_K=40
MIN_SIMILARITY=0.25
SCORE_FLOOR=0.008
MMR_LAMBDA=0.7
VECTOR_WEIGHT=1.0
KEYWORD_WEIGHT=0.7
RRF_K=60

# --- worker ------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2
JOB_STALE_AFTER_SECONDS=900

# --- storage -----------------------------------------------------------------
STORAGE_BUCKET=nexus-documents
SIGNED_UPLOAD_TTL_SECONDS=300
SIGNED_DOWNLOAD_TTL_SECONDS=60

# --- optional ----------------------------------------------------------------
SENTRY_DSN=
